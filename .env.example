# Шаблон обязательных переменных окружения. Скопируйте в .env.test / .env.prod
# и заполните реальными значениями - сами .env.* файлы в git не попадают.

APP_ENV=prod

BOT_TOKEN=
CHAT_ID=
ERROR_TOPIC_ID=

# Telethon-сессия, используется для чтения заголовков форум-топиков.
API_ID=
API_HASH=
CHAT_PEER_ID=

REDIS_HOST=
REDIS_PORT=6379
REDIS_DB=0
