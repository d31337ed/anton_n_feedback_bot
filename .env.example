# Required env vars template. Copy to .env.test / .env.prod and fill in real
# values - the .env.* files themselves are gitignored.

APP_ENV=prod

BOT_TOKEN=
CHAT_ID=
ERROR_TOPIC_ID=

# Comma-separated user IDs. Empty = no restriction.
ALLOWED_USER_IDS=

# Hotel request mini app: public HTTPS URL (nginx proxies it to WEBAPP_HOST:WEBAPP_PORT).
WEBAPP_URL=
WEBAPP_HOST=127.0.0.1
WEBAPP_PORT=8090

REDIS_HOST=
REDIS_PORT=6379
REDIS_DB=0
