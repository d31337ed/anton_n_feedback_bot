# Required env vars template. Copy to .env.test / .env.prod and fill in real
# values - the .env.* files themselves are gitignored.

APP_ENV=prod

BOT_TOKEN=
CHAT_ID=
ERROR_TOPIC_ID=

# Telethon session, used to read forum topic titles.
API_ID=
API_HASH=
CHAT_PEER_ID=

# Comma-separated user IDs. Empty = no restriction.
ALLOWED_USER_IDS=

REDIS_HOST=
REDIS_PORT=6379
REDIS_DB=0
